// Proving-slice Guardfile: the forgejo repo get/create/delete trio on ward.
// Each `can` binds its op explicitly; quotes live only in the header.
wrap ward ops forgejo {
    spec forgejo.swagger.v1.json
    base-url "https://forgejo.example/api/v1"
    auth header-token {
        header Authorization
        prefix "token "
        value ssm "/forgejo/api-token"
    }

    can get repos { op "repoGet" }
    can create repos { op "createCurrentUserRepo" }
    can delete repos { op "repoDelete" }
}
